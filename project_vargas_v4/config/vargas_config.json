{
  "model": "gemini-2.5-pro",
  "embedding_model": "gemini-embedding-001",
  "fallback_model": "gemini-2.5-pro",
  "lightweight_model": "gemini-2.5-flash",
  "temperature": 0.7,
  "max_tokens": 4096,
  "use_function_calling": true,
  "qdrant_url": "http://localhost:6333",
