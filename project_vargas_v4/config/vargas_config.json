    "retention_threshold": 0.3,
    "max_tokens": 128000,
    "tokens_per_char": 0.25,
    "compression_retention_threshold": 0.75,
    "paradox_archive_max": 1000
  },
  "heartbeat": {
    "enabled": false,
    "interval_minutes": 30,
    "channel_id": "1472949447607587071",
    "tasks": ["sovereign_health_check", "memory_summary", "tool_log_review"]
  }
