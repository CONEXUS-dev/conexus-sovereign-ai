# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
ALLOWED_CHANNELS=channel_id_1,channel_id_2,channel_id_3

# Google Gemini API Configuration
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Google Custom Search (for web search)
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# OpenAI API (for Whisper voice transcription)
OPENAI_API_KEY=your_openai_api_key_here

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
# For Qdrant Cloud (optional)
QDRANT_URL=your_qdrant_cloud_url_here
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# V4 ECP Configuration
VARGAS_DISCORD_LISTENER=true

# Logging
LOG_LEVEL=INFO
