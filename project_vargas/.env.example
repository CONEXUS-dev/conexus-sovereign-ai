# Project Vargas — Environment Variables
# Copy this file to .env and fill in your values.

# Discord bot token (from Discord Developer Portal)
DISCORD_TOKEN=YOUR_DISCORD_TOKEN_HERE

# Gemini API key (from Google AI Studio)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Google Custom Search (for web search capability)
GOOGLE_CSE_API_KEY=YOUR_GOOGLE_CSE_API_KEY_HERE
GOOGLE_CSE_ID=YOUR_CSE_ID_HERE

# OpenAI API key (for Whisper voice transcription — V3)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Qdrant (defaults work for local Docker)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Qdrant Cloud (for cloud deploy — overrides QDRANT_HOST/PORT)
# QDRANT_URL=https://your-cluster.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key
